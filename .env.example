# .env 配置示例文件
# 请将此文件复制为 .env 并填入真实的配置信息

# LLM配置（OpenAI-compatible）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://your-llm-provider/v1
LLM_MODEL=your_model_name

# Fish Audio API配置
FISH_API_KEY=your_fish_audio_api_key_here
FISH_TTS_MODEL=
# 正文英文翻译朗读音色
FISH_REFERENCE_ID=
# 动态开场中文播报音色（会朗读真实考试年月与四/六级）
FISH_OPENING_REFERENCE_ID=
FISH_CET_ZH_REFERENCE_ID=
FISH_DAILY_EN_REFERENCE_ID=
FISH_DAILY_ZH_REFERENCE_ID=

# 固定 MP3 更换后的本地字幕识别
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# 默认 int8 兼容 CPU/GPU；支持的 GPU 也可按环境设为 float16
WHISPER_COMPUTE_TYPE=int8

# Anthropic API配置（用于AI翻译和关键词提取）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pexels API配置（用于搜索背景素材）
PEXELS_API_KEY=your_pexels_api_key_here
